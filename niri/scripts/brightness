#!/usr/bin/env bash
## Niri brightness via sysfs. Floor 10%. Step 10%.

iDIR="$HOME/.config/niri/mako/icons"
STEP_PCT=10
MIN_PCT=10

bl_dir() {
	if [[ -d /sys/class/backlight/intel_backlight ]]; then
		printf '%s' /sys/class/backlight/intel_backlight
		return
	fi
	find /sys/class/backlight -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n1
}

read_int() { tr -d '[:space:]' < "$1" 2>/dev/null; }

get_raw() { read_int "$(bl_dir)/brightness"; }
get_max() { read_int "$(bl_dir)/max_brightness"; }

get_percent() {
	local cur max pct
	cur=$(get_raw); max=$(get_max)
	[[ -n "$cur" && -n "$max" && "$max" -gt 0 ]] || { printf '0'; return 1; }
	pct=$(( (cur * 100 + max / 2) / max ))
	(( pct > 100 )) && pct=100
	printf '%s' "$pct"
}

set_percent() {
	local dir max raw min_raw
	dir=$(bl_dir) || return 1
	max=$(get_max) || return 1
	raw=$(( max * $1 / 100 ))
	min_raw=$(( max * MIN_PCT / 100 ))
	(( raw < min_raw )) && raw=$min_raw
	(( raw > max )) && raw=$max
	if ! printf '%s' "$raw" > "$dir/brightness" 2>/dev/null; then
		notify-send -u low -a "brightness" \
			"Brightness" "Cannot write $dir/brightness — add your user to the video group"
		return 1
	fi
}

get_icon() {
	current="$(get_percent)"
	if [[ "$current" -le 20 ]]; then icon="$iDIR/brightness-20.png"
	elif [[ "$current" -le 40 ]]; then icon="$iDIR/brightness-40.png"
	elif [[ "$current" -le 60 ]]; then icon="$iDIR/brightness-60.png"
	elif [[ "$current" -le 80 ]]; then icon="$iDIR/brightness-80.png"
	else icon="$iDIR/brightness-100.png"
	fi
	[[ -f "$icon" ]] || icon="display-brightness-symbolic"
}

notify_bl() {
	notify-send -u low -a "brightness" -i "$icon" \
		-h string:x-canonical-private-synchronous:obbacklight \
		"Brightness : $(get_percent)%" >/dev/null 2>&1
}

inc_backlight() {
	local pct; pct=$(get_percent)
	pct=$(( pct + STEP_PCT )); (( pct > 100 )) && pct=100
	set_percent "$pct" || return
	get_icon && notify_bl
}

dec_backlight() {
	local pct; pct=$(get_percent)
	pct=$(( pct - STEP_PCT )); (( pct < MIN_PCT )) && pct=$MIN_PCT
	set_percent "$pct" || return
	get_icon && notify_bl
}

case "${1:-}" in
	--get) printf '%s%%\n' "$(get_percent)" ;;
	--inc) inc_backlight ;;
	--dec) dec_backlight ;;
	*)     printf '%s%%\n' "$(get_percent)" ;;
esac
